# URL canónica pública: OG, sitemap, feed, embeds y redirectTo de invitaciones Auth.
# Tiene que ser pública y estar en la allowlist de redirecciones de Supabase
# para que un invitado remoto abra el email. localhost solo funciona en la
# máquina que ejecuta la app. Si falta, las invitaciones usan http://localhost:3000
# y el resto del sitio usa https://dwellhavana.com.
NEXT_PUBLIC_SITE_URL=https://dwellhavana.com

# Email público de contacto (mailto en /about y el footer).
# Si falta, el sitio muestra el placeholder hola@dwellhavana.example.
NEXT_PUBLIC_CONTACT_EMAIL=hola@dwellhavana.example

# Copiar a .env.local (nunca commitear: .env* está en .gitignore)
# Se obtienen en Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Admin mínimo para /admin/review (Fase 1, paso 5)
ADMIN_TOKEN=cambia-esto-por-un-secreto-largo
# Duración de la cookie de fallback, en segundos. Default: 7 días.
ADMIN_TOKEN_TTL_SECONDS=604800

# E2E opcional: usar solo un proyecto Supabase de testing, nunca producción
E2E_SUPABASE_URL=https://testing-project.supabase.co
E2E_SUPABASE_PUBLISHABLE_KEY=sb_publishable_testing_only
E2E_SUPABASE_SERVICE_ROLE_KEY=sb_secret_testing_only
E2E_CONTRIBUTOR_HANDLE=@e2e-contributor
E2E_AUTH_COOKIE=sb-<project-ref>-auth-token=<captured-test-session>
E2E_SUPABASE_CONFIRM=dwell-havana-e2e
